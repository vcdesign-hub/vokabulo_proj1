---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SUPPORTED_LANGS } from '../../utils/i18n';
import { loadWhatMakesItGreatCopy } from '../../utils/what_makes_it_great';

// 1. Import Global Styles (Matches index.astro structure)
import '../../styles/styles.css';

export function getStaticPaths() {
  return SUPPORTED_LANGS.map(lang => ({ params: { lang } }));
}

const { lang = 'en' } = Astro.params;

// 2. Load the data object
const pageData = loadWhatMakesItGreatCopy(lang);

// 3. Page Meta
const title = `${pageData.hero.title} — ${pageData.hero.subtitle}`;
const description = pageData.hero.description;
---

<BaseLayout title={title} description={description} currentLang={lang}>
  
  <main class="w-full overflow-x-hidden">

    <section class="relative min-h-[90vh] flex flex-col items-center justify-start pt-40 pb-20 px-6 text-center">
      <div class="animate-fade-up z-10 max-w-4xl mx-auto space-y-8">
        <div class="mx-auto max-w-4xl space-y-3 text-center">

            <h2 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
                {pageData.hero.subtitle}
              </h2>
              <p class="text-lg leading-relaxed text-slate-700 sm:text-xl">
                {pageData.hero.description}
              </p>
            
        </div>
        <div 
        class="animate-fade-up flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-center pt-2"
        style="animation-delay: 0.6s;"
      >
        <a class="bg-accent text-white px-8 py-3 rounded-full font-bold text-sm shadow-lg transition-all duration-300 hover:scale-105 flex items-center gap-2" href=#>{pageData.hero.secondaryCta}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14m-7-7l7 7-7 7"/></svg>
        </a>
      </div>

      </div>
<br>
<br>
        
<div class="relative w-full max-w-5xl mx-auto mt-16 h-48 sm:h-64 isolate">
  
   <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3/4 h-full bg-orange-500/10 dark:bg-blue-500/10 blur-[80px] rounded-full animate-glow-pulse -z-10"></div>
 
   <div class="absolute left-4 sm:left-12 top-10 sm:top-12 animate-float-1 z-10">
     <div class="card px-5 py-3 flex items-center gap-3 !rounded-2xl !border-slate-200/60 dark:!border-slate-700/60 backdrop-blur-md shadow-sm">
       <div class="w-10 h-10 rounded-full bg-blue-50 dark:bg-slate-800 flex items-center justify-center text-blue-500">
         <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4c0-1.1.9-2 2-2h8a2 2 0 0 1 2 2v5Z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/></svg>
       </div>
       <div class="text-left hidden sm:block">
         <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Smart</p>
         <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Context Aware</p>
       </div>
     </div>
   </div>
 
   <div class="absolute left-1/2 -translate-x-1/2 top-0 animate-float-2 z-20">
     <div class="card px-8 py-4 flex flex-col items-center gap-2 !rounded-3xl border-2 !border-orange-100 dark:!border-slate-700 shadow-xl bg-white/80 dark:bg-slate-900/80">
       <div class="flex items-center gap-2 mb-1">
         <span class="relative flex h-3 w-3">
           <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--accent)] opacity-75"></span>
           <span class="relative inline-flex rounded-full h-3 w-3 bg-[var(--accent)]"></span>
         </span>
         <span class="text-xs font-bold text-[var(--accent)] uppercase tracking-widest">Mastery</span>
       </div>
       <p class="text-2xl font-bold text-slate-800 dark:text-white">Internalized.</p>
       <div class="w-32 h-1.5 bg-slate-100 dark:bg-slate-700 rounded-full mt-1 overflow-hidden">
         <div class="h-full bg-[var(--accent-gradient)] w-[85%] rounded-full"></div>
       </div>
     </div>
   </div>
 
   <div class="absolute right-4 sm:right-12 top-14 sm:top-16 animate-float-3 z-10">
     <div class="card px-5 py-3 flex items-center gap-3 !rounded-2xl !border-slate-200/60 dark:!border-slate-700/60 backdrop-blur-md shadow-sm">
       <div class="text-left hidden sm:block">
         <p class="text-xs font-bold text-slate-400 uppercase tracking-wider text-right">Boost</p>
         <p class="text-sm font-semibold text-slate-700 dark:text-slate-200 text-right">50% Faster</p>
       </div>
       <div class="w-10 h-10 rounded-full bg-green-50 dark:bg-slate-800 flex items-center justify-center text-green-500">
         <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
       </div>
     </div>
   </div>
 
 </div>
    </section>


    <section class="py-24 px-6 bg-slate-50 dark:bg-[#0b1220]">
      <div class="max-w-5xl mx-auto text-center space-y-6">

        <h2 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
            {pageData.family.title}

          </h2>
          <p class="text-lg leading-relaxed text-slate-700 sm:text-xl">
            {pageData.family.description}

          </p>
      </div>
    </section>


    <section class="py-32 px-6 max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="order-2 md:order-1 space-y-6">
          
            <h2 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
                {pageData.recall.title}

              </h2>
              <p class="text-lg leading-relaxed text-slate-700 sm:text-xl">
                {pageData.recall.desc1}

              </p>
              <p class="text-lg leading-relaxed text-slate-700 sm:text-xl">
                {pageData.recall.desc2}


              </p>
          
        </div>
        
        <div class="order-1 md:order-2 perspective-container">
           <div class="theme-dark w-full max-w-md mx-auto">
              <div class="card p-8 aspect-[4/5] flex flex-col items-center justify-center relative overflow-hidden">
               <div class="w-full max-w-[280px] bg-black rounded-[3rem] border-4 border-slate-700 p-3 shadow-2xl relative">
                    <div class="bg-slate-900 rounded-[2.5rem] aspect-[9/19] relative overflow-hidden flex flex-col items-center pt-12 border border-slate-800">
                         <div class="absolute inset-0 flex items-center justify-center">
                            <div class="w-64 h-64 border border-[var(--accent)]/30 rounded-full absolute animate-ping" style="animation-duration: 3s;"></div>
                            <div class="w-48 h-48 border border-[var(--accent)]/50 rounded-full absolute animate-ping" style="animation-duration: 3s; animation-delay: 0.5s;"></div>
                         </div>
                         
                         <div class="w-20 h-20 rounded-full border-4 border-[var(--accent)] flex items-center justify-center mb-6 z-10 bg-slate-900">
                            <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                         </div>
                         <div class="text-center px-6 z-10">
                            <h3 class="text-white text-lg font-bold mb-1">{pageData.recall.ui.screenTitle}</h3>
                            <p class="text-slate-400 text-xs">{pageData.recall.ui.screenSubtitle}</p>
                         </div>
                         <div class="mt-auto mb-8 z-10">
                            <button class="px-6 py-3 rounded-full bg-white text-black font-semibold text-sm hover:scale-105 transition-transform">
                                {pageData.recall.ui.button}
                            </button>
                         </div>
                    </div>
                </div>
              </div>
           </div>
        </div>
      </div>
    </section>


    <section class="py-32 bg-slate-900 text-white overflow-hidden relative">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_#1e293b_0%,_#020617_100%)]"></div>
      
      <div class="relative z-10 max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
         <div class="flex flex-col justify-center ">
            <h2 class="text-[15vw] md:text-[8rem] font-bold leading-none tracking-tighter text-[var(--accent)] opacity-30 blur-[2px]">
               {pageData.precision.cold}
            </h2>
            <h2 class="text-[15vw] md:text-[8rem] font-bold leading-none tracking-tighter text-[var(--accent)] opacity-60 blur-[1px]">
               {pageData.precision.warm}
            </h2>
            <h2 class="text-[15vw] md:text-[8rem] font-bold leading-none tracking-tighter text-[var(--accent)]">
               {pageData.precision.warmer}
           </h2>
         </div>
         
         <div class="space-y-8">

            <h2 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
                {pageData.precision.title}
              </h2>
              <p class="text-lg leading-relaxed text-slate-700 sm:text-xl">
                {pageData.precision.description}

              </p>



            
            <div class="theme-dark w-full max-w-sm mx-auto">
               <div class="card p-8 border-slate-700 bg-slate-800/40 backdrop-blur-xl">
                  <div class="flex items-center justify-between text-slate-200 mb-2">
                     <span class="text-5xl font-bold">{pageData.precision.ui.matchPercent}</span>
                     <div class="text-right">
                        <span class="block text-xs uppercase tracking-widest text-[var(--accent)]">{pageData.precision.ui.matchLabel}</span>
                        <span class="text-xl font-medium">{pageData.precision.ui.accuracyLabel}</span>
                     </div>
                  </div>
                  <div class="w-full h-16 mt-4 flex items-center">
                     <div class="flex-1 h-0.5 bg-slate-700"></div>
                     <svg class="w-12 h-12 text-[var(--accent)] mx-4 rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                     <div class="flex-1 h-0.5 bg-slate-700"></div>
                  </div>
               </div>
            </div>
         </div>
     </div>
    </section>


    <section class="py-32 px-6 max-w-4xl mx-auto text-center relative overflow-hidden">
      <h2 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
        {pageData.network.title}
      </h2>
      <div class="theme-dark w-full max-w-lg mx-auto aspect-video relative mt-12">
          <div class="card w-full h-full flex items-center justify-center overflow-hidden border-slate-200 dark:border-slate-800">
             <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#FF6B35_2px,transparent_2px)] [background-size:30px_30px]"></div>
             <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 bg-[var(--accent)] blur-[60px] opacity-40"></div>
             <img src="/images/logo on dark.svg" class="w-24 relative z-10 drop-shadow-2xl" alt="Network Center" />
          </div>
      </div>
    </section>


    <section class="py-24 bg-slate-50 dark:bg-[#0b1220] overflow-hidden">
       <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">
          
         <div class="relative flex justify-center">
             <div class="theme-dark perspective-container w-full max-w-xs">
                <div class="card p-0 aspect-[9/16] overflow-hidden relative rotate-[-6deg] hover:rotate-0 transition-transform duration-700 shadow-2xl">
                   <div class="absolute inset-0 bg-gradient-to-b from-slate-800 to-black"></div>
                   <div class="absolute top-1/4 left-4 right-4 bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/20">
                      <div class="flex items-center gap-3 mb-2">
                         <div class="w-8 h-8 rounded-lg bg-[var(--accent)] flex items-center justify-center text-white">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                         </div>
                         <span class="text-white text-xs font-bold uppercase">{pageData.smartReview.ui.badge}</span>
                      </div>
                      <p class="text-white font-semibold text-sm">{pageData.smartReview.ui.title}</p>
                      <p class="text-slate-300 text-xs mt-1">{pageData.smartReview.ui.subtitle}</p>
                   </div>
               </div>
             </div>
          </div>

          <div class="space-y-8">

            <h2 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl ">
                {pageData.smartReview.title}
              </h2>
              <p class="text-lg leading-relaxed text-slate-700 sm:text-xl">
                {pageData.smartReview.desc1}
              </p>
              <p class="text-lg leading-relaxed text-slate-700 sm:text-xl">
                {pageData.smartReview.desc2}
              </p>

          </div>
       </div>
    </section>


    <section class="py-32 px-6 max-w-5xl mx-auto text-center">
       <div class="mb-12 inline-block p-6 rounded-[2rem] bg-slate-100 dark:bg-slate-800">
          <svg class="w-16 h-16 text-[var(--accent)] mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
       </div>

       <div class="space-y-6">
      <h2 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
        {pageData.privacy.title}
      </h2>
      <p class="text-lg leading-relaxed text-slate-700 sm:text-xl">
        {pageData.privacy.desc1}
      </p>
      </div>


      <p class="text-lg leading-relaxed text-slate-700 sm:text-xl">
        {pageData.privacy.desc2}
      </p>
    </section>


    <section class="py-24 bg-white dark:bg-[#0b1220]">
      <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-12">
        
        <div class="theme-dark h-full">
           <div class="card p-10 h-full flex flex-col justify-between min-h-[400px]">
              <div class="space-y-6">
                <h2 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
                    {pageData.setup.cardTitle}
                  </h2>
                  <p class="text-lg leading-relaxed text-slate-700 sm:text-xl">
                    {pageData.setup.cardDesc}
                  </p>
              </div>
              
              <div class="mt-8 p-4 bg-slate-800/80 backdrop-blur rounded-2xl border border-slate-600 flex items-center gap-4">
                 <div class="w-10 h-10 rounded-full bg-red-500/20 flex items-center justify-center text-red-500 shrink-0">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></path></svg>
                 </div>
                 <div class="text-sm text-slate-200">
                    <span class="font-bold block">{pageData.setup.alertTitle}</span>
                    {pageData.setup.alertDesc}
                 </div>
              </div>
           </div>
        </div>

        <div class="flex flex-col justify-center pl-0 md:pl-10 space-y-6">
            <h2 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
                {pageData.setup.title}
            </h2>
            <p class="text-lg leading-relaxed text-slate-700 sm:text-xl">
                {pageData.setup.description}
            </p>
           
           <div class="theme-dark mt-4">
              <div class="card w-full max-w-sm p-4 flex items-center gap-4 shadow-xl">
                  <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center">
                    <img src="/images/logo on white.svg" class="w-6 h-6" alt="Logo" />
                  </div>
                  <div>
                     <div class="text-white font-bold text-sm">Daily Goal</div>
                     <div class="text-slate-400 text-xs">Ready to start</div>
                  </div>
                  <button class="ml-auto px-5 py-2 bg-[var(--accent)] text-white text-xs font-bold rounded-full">
                     Begin
                  </button>
              </div>
           </div>
        </div>
      </div>
    </section>


    <section class="py-24 px-6 max-w-7xl mx-auto">
       <div class="grid md:grid-cols-3 gap-6 mb-6">
          
          <div class="theme-dark">
             <div class="card h-full p-10 flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-full bg-slate-800 flex items-center justify-center mb-6 text-[var(--accent)]">
                   <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <div class="space-y-3">
                <h3 class="text-lg font-semibold text-slate-900 leading-tight">
                    {pageData.grid.memory.title}
                </h3>
                <p class="text-sm text-slate-600 leading-relaxed">
                    {pageData.grid.memory.desc}
                </p>
                </div>

             </div>
          </div>

          <div class="theme-dark">
             <div class="card h-full p-10 flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-full bg-slate-800 flex items-center justify-center mb-6 text-blue-400">
                   <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                </div>
                <div class="space-y-3">
                <h3 class="text-lg font-semibold text-slate-900 leading-tight">
                    {pageData.grid.fluidity.title}
                </h3>
                <p class="text-sm text-slate-600 leading-relaxed">
                    {pageData.grid.fluidity.desc}
                </p>
                </div>

             </div>
          </div>

          <div class="theme-dark">
             <div class="card h-full p-10 flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-full bg-slate-800 flex items-center justify-center mb-6 text-pink-400 font-serif italic text-2xl border border-slate-700">
                   B2
                </div>
                <div class="space-y-3">
                <h3 class="text-lg font-semibold text-slate-900 leading-tight">
                    {pageData.grid.personal.title}
                </h3>
                <p class="text-sm text-slate-600 leading-relaxed">
                    {pageData.grid.personal.desc}
                </p>
               </div>
             </div>
          </div>
       </div>

       <div class="theme-dark">
          <div class="card p-10 flex flex-col md:flex-row items-center gap-12">
             <div 
             class="flex-1 text-center md:text-left">
             <div class="space-y-3">
             <h3 class="text-lg font-semibold text-slate-900 leading-tight">
                {pageData.grid.environment.title}
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
                {pageData.grid.environment.desc}
            </p>
         </div>
             </div>
             <div class="w-20 h-20 flex-shrink-0">
                <svg class="w-full h-full text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
             </div>
          </div>
       </div>
    </section>

  </main>
</BaseLayout>